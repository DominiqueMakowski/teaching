{
  "name": "agentic-coding-slides",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "rm -f index.html && slidev build slides.md --out dist --base ./ && rm -rf assets && cp dist/index.html . && cp -r dist/assets . && rm -rf dist",
    "pdf": "slidev export slides.md --output AgenticCoding.pdf"
  },
  "dependencies": {
    "@slidev/cli": "^52.20.1",
    "@slidev/theme-default": "^0.25.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@slidev/types": "^52.20.1"
  }
}
